{
  "name": "car-shop-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "migration:generate": "pnpm build && typeorm migration:generate ./src/migrations/CreateCarShopTables -d ./dist/database/data-source.js",
    "migration:run": "pnpm build && typeorm migration:run -d ./dist/database/data-source.js",
    "migration:show": "pnpm build && typeorm migration:show -d ./dist/database/data-source.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^16.4.7",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@10.34.9"
}
